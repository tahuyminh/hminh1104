            <a href="https://zalo.me/g/7uacp6cbpvjyt7ah7vlp" class="link-btn zalo">
                <i class="fas fa-users"></i>
                <span>Box Zalo Thông Báo</span>
            </a>
            <a href="https://discord.gg/AHPYTSQws" class="link-btn discord">
                <i class="fab fa-discord"></i>
