    <!-- Thẻ Audio với link MP3 mới -->
    <audio id="bgMusic" loop preload="auto">
        <source src="https://straightforward-gray-wo4hh1z3.edgeone.dev/" type="audio/mpeg">
        Trình duyệt của bạn không hỗ trợ audio.
    </audio>

    <script>
        // ----- ÂM NHẠC TỰ ĐỘNG PHÁT -----
        const audio = document.getElementById('bgMusic');
        const musicBtn = document.getElementById('musicBtn');
        let isPlaying = false;

        // Hàm bật/tắt nhạc (dùng cho nút)
        function togglePlay() {
            if (isPlaying) {
                audio.pause();
                isPlaying = false;
                musicBtn.classList.remove('playing');
                musicBtn.querySelector('i').className = 'fas fa-music';
            } else {
                audio.play().then(() => {
                    isPlaying = true;
                    musicBtn.classList.add('playing');
                    musicBtn.querySelector('i').className = 'fas fa-music';
                }).catch(err => {
                    console.warn('Không thể phát nhạc:', err);
                });
            }
        }

        musicBtn.addEventListener('click', togglePlay);

        // Thử tự động phát khi trang tải
        function tryAutoPlay() {
            audio.play().then(() => {
                isPlaying = true;
                musicBtn.classList.add('playing');
                musicBtn.querySelector('i').className = 'fas fa-music';
            }).catch(() => {
                // Nếu bị chặn, đợi người dùng click bất kỳ đâu để phát lần đầu
                document.addEventListener('click', function firstClick() {
                    audio.play().then(() => {
                        isPlaying = true;
                        musicBtn.classList.add('playing');
                        musicBtn.querySelector('i').className = 'fas fa-music';
                    }).catch(err => console.warn('Không thể phát nhạc sau click:', err));
                    document.removeEventListener('click', firstClick);
                }, { once: true });
            });
        }

        // Gọi sau khi DOM tải
        document.addEventListener('DOMContentLoaded', tryAutoPlay);

        // Nếu audio bị lỗi (ví dụ link hỏng)
        audio.addEventListener('error', () => {
            console.warn('Lỗi tải file nhạc. Kiểm tra lại đường dẫn.');
            if (isPlaying) {
                isPlaying = false;
                musicBtn.classList.remove('playing');
                musicBtn.querySelector('i').className = 'fas fa-music';
            }
        });

        // ----- PARTICLE -----
        (function() {
            const canvas = document.getElementById('particle-canvas');
            const ctx = canvas.getContext('2d');

            let width, height;
            let particles = [];
            const PARTICLE_COUNT = 60;

            class Particle {
                constructor() {
                    this.x = Math.random() * width;
                    this.y = Math.random() * height;
                    this.size = Math.random() * 4 + 2;
                    this.speedX = (Math.random() - 0.5) * 0.45;
                    this.speedY = (Math.random() - 0.5) * 0.45;
                    const hue = 240 + Math.random() * 60;
                    this.color = `hsla(${hue}, 75%, 70%, ${0.3 + Math.random() * 0.3})`;
                }

                update() {
                    this.x += this.speedX;
                    this.y += this.speedY;
                    if (this.x < 0 || this.x > width) {
                        this.speedX *= -1;
                        this.x = Math.max(0, Math.min(width, this.x));
                    }
                    if (this.y < 0 || this.y > height) {
                        this.speedY *= -1;
                        this.y = Math.max(0, Math.min(height, this.y));
                    }
                }

                draw() {
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                    ctx.fillStyle = this.color;
                    ctx.shadowColor = 'rgba(160, 120, 255, 0.12)';
                    ctx.shadowBlur = 12;
                    ctx.fill();
                    ctx.shadowBlur = 0;
                }
            }

            function initParticles() {
                particles = [];
                for (let i = 0; i < PARTICLE_COUNT; i++) {
                    particles.push(new Particle());
                }
            }

            function resizeCanvas() {
                width = window.innerWidth;
                height = window.innerHeight;
                canvas.width = width;
                canvas.height = height;
                initParticles();
            }

            function animate() {
                ctx.clearRect(0, 0, width, height);
                particles.forEach(p => {
                    p.update();
                    p.draw();
                });

                ctx.shadowBlur = 0;
                for (let i = 0; i < particles.length; i++) {
                    for (let j = i + 1; j < particles.length; j++) {
                        const dx = particles[i].x - particles[j].x;
                        const dy = particles[i].y - particles[j].y;
                        const dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < 100) {
                            const opacity = 0.06 * (1 - dist / 100);
                            ctx.beginPath();
                            ctx.moveTo(particles[i].x, particles[i].y);
                            ctx.lineTo(particles[j].x, particles[j].y);
                            ctx.strokeStyle = `rgba(180, 150, 255, ${opacity})`;
                            ctx.lineWidth = 0.6;
                            ctx.stroke();
                        }
                    }
                }

                requestAnimationFrame(animate);
            }

            window.addEventListener('resize', resizeCanvas);
            resizeCanvas();
            animate();

            canvas.addEventListener('click', (e) => {
                const rect = canvas.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                for (let i = 0; i < 5; i++) {
                    const p = new Particle();
                    p.x = x + (Math.random() - 0.5) * 30;
                    p.y = y + (Math.random() - 0.5) * 30;
                    p.size = Math.random() * 5 + 2;
                    particles.push(p);
                }
                if (particles.length > 180) {
                    particles.splice(0, particles.length - 180);
                }
            });
        })();
    </script>

</body>
</html>